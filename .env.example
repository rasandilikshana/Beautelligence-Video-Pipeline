# ===================
# APPLICATION
# ===================
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ===================
# DATABASE
# ===================
DATABASE_URL=postgresql+asyncpg://beautelligence:password@localhost:5432/beautelligence_pipeline
DATABASE_POOL_SIZE=5

# ===================
# GOOGLE AI / GEMINI
# ===================
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ===================
# VEO 3 VIDEO GENERATION
# ===================
VEO_MODEL=veo-3.0-fast-generate-001
VEO_RESOLUTION=720p
VEO_ASPECT_RATIO=9:16
VEO_DURATION_SECONDS=8

# ===================
# TIKTOK SCRAPING
# ===================
TIKTOK_CC_BASE_URL=https://ads.tiktok.com/business/creativecenter
TIKTOK_REGION=US
TIKTOK_SCRAPE_INTERVAL_HOURS=6

# ===================
# RATE LIMITS
# ===================
DAILY_VIDEO_LIMIT=3
GEMINI_RPM_LIMIT=60
VEO_DAILY_LIMIT=10

# ===================
# KEYWORD SETTINGS
# ===================
KEYWORD_EXPIRY_DAYS=30
MIN_TRENDING_SCORE=70

# ===================
# FILE STORAGE
# ===================
VIDEO_OUTPUT_DIR=./data/videos
PROMPT_LOG_DIR=./data/prompts
LOG_DIR=./data/logs

# ===================
# OPTIONAL: REDIS CACHE
# ===================
# REDIS_URL=redis://localhost:6379/0
